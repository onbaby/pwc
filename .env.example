# Copy to .env (never commit .env). Everything is OPTIONAL: the demo runs fully offline in replay mode.
PORT=8787
# replay (default) | console | photon
CHANNEL=replay
SANDBOX=1
# KEEP_DATA=1 keeps the sandbox database between boots (default: reset on boot)

# Photon Spectrum (iMessage), only for CHANNEL=photon. Dashboard -> project settings.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Opted-in team phones (E.164). Real numbers live only here, never in the repo or the sample data.
PHONE_MAYA=
PHONE_DEV=
