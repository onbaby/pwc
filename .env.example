# Copy to .env (never commit .env). Everything here is OPTIONAL: the demo runs fully offline in
# CHANNEL=replay or CHANNEL=console with none of these set.

# --- Photon Spectrum (iMessage) -- only for CHANNEL=photon -----------------------------------
# Dashboard -> project settings.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Team-member phones that have opted in (E.164). Real numbers live only here, never in the repo.
PERSONA_MAYA_PHONE=
PERSONA_PRIYA_PHONE=
PERSONA_DEV_PHONE=

# --- Optional LLM fallback for free-text intent parsing (stretch goal, default OFF) ----------
# PARSER=rules (default) | rules+llm
PARSER=rules
ANTHROPIC_API_KEY=
# Pin the model id explicitly and verify it against Anthropic's current model list before use.
LLM_MODEL=

# --- Server ---------------------------------------------------------------------------------
PORT=8787
